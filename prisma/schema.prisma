generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  country   String
  contact   String
  socials   String
  createdAt DateTime @default(now())

  @@map("registrations")
}
